<Window x:Class="DataSync.Views.ClearDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clear local data"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24,20">
        <TextBlock Text="Clear local data" Style="{StaticResource SectionTitle}" FontSize="18" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"
                   Text="Replication will stop, all replicated data in the local database will be deleted, and the application will restart." />

        <TextBlock Text="Password" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,4" />
        <PasswordBox x:Name="PasswordBox" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Clear data" IsDefault="True" MinWidth="110"
                    Style="{StaticResource DangerButton}" Click="ClearButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
