<Window x:Class="DataSync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="768" Height="576" MinWidth="768" MinHeight="576"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource HeaderBrush}" Padding="14,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Current Time" Foreground="{StaticResource HeaderMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" />
                    <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource HeaderButton}" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rig Name" Foreground="{StaticResource HeaderMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding RigName}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Task status and actions -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Real-Time Data Task" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding RealTimeState}" Style="{StaticResource StateValue}" />
                            <TextBlock Grid.Row="3" Text="Batch" Style="{StaticResource FieldLabel}" ToolTip="Rows per remote read and recent copy rate" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RealTimeBatch}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="1" Text="Last Record" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastBaseId}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="Last Record Time" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastRecordTime}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sync Old Data Task" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding SyncState}" Style="{StaticResource StateValue}" />
                            <TextBlock Grid.Row="1" Text="Next Record" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SyncNextBaseId}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="Batch" Style="{StaticResource FieldLabel}" ToolTip="BaseIDs per remote read and recent copy rate" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SyncBatch}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <Button Content="{Binding SyncButtonText}" Command="{Binding ToggleSyncCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5" />
                    <Button Content="Test Remote Connection" Command="{Binding TestRemoteConnectionCommand}" Margin="0,0,0,5" />
                    <Button Content="Test Local Connection" Command="{Binding TestLocalConnectionCommand}" Margin="0,0,0,5" />
                    <Button Content="Clear Local Data" Command="{Binding ClearLocalDataCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
                    <UniformGrid Columns="2">
                        <Button Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,3,0" />
                        <Button Content="Close" Click="CloseButton_Click" Margin="3,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ranges and messages -->
        <TabControl Grid.Row="2" Margin="10" Padding="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}">
            <TabItem Header="Details" Padding="10,3">
                <DataGrid ItemsSource="{Binding Ranges}" BorderThickness="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Syncing">
                                    <Setter Property="Background" Value="{StaticResource SyncingRowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="RealTime">
                                    <Setter Property="Background" Value="{StaticResource RealTimeRowBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Begin Record" Binding="{Binding BaseIdBegin}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="End Record" Binding="{Binding BaseIdEnd}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Sync Starting Record" Binding="{Binding StartSyncPoint}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Messages" Padding="10,3">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Clear Messages" Command="{Binding ClearMessagesCommand}" />
                            <Button Content="Open Log Folder" Command="{Binding OpenLogFolderCommand}" Margin="6,0,0,0"
                                    ToolTip="Opens the folder with the full log files, e.g. to send them for troubleshooting" />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Messages}" BorderThickness="0" FontFamily="Consolas" Padding="2" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
