<Window x:Class="DataSync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100" Height="850" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Current Time" Foreground="{StaticResource HeaderMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontFamily="Consolas" FontSize="17" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rig Name" Foreground="{StaticResource HeaderMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding RigName}" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Task status and actions -->
        <Grid Grid.Row="1" Margin="16,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Real-Time Data Task" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding RealTimeState}" Style="{StaticResource StateValue}" />
                            <TextBlock Grid.Row="1" Text="Last Record" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastBaseId}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="Last Record Time" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastRecordTime}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Sync Old Data Task" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding SyncState}" Style="{StaticResource StateValue}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <Button Content="{Binding SyncButtonText}" Command="{Binding ToggleSyncCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                    <Button Content="Test Remote Connection" Command="{Binding TestRemoteConnectionCommand}" Margin="0,0,0,8" />
                    <Button Content="Test Local Connection" Command="{Binding TestLocalConnectionCommand}" Margin="0,0,0,8" />
                    <Button Content="Clear Local Data" Command="{Binding ClearLocalDataCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,16" />
                    <UniformGrid Columns="2">
                        <Button Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,4,0" />
                        <Button Content="Close" Click="CloseButton_Click" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ranges and messages -->
        <TabControl Grid.Row="2" Margin="16" Padding="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}">
            <TabItem Header="Details" Padding="14,6">
                <DataGrid ItemsSource="{Binding Ranges}" BorderThickness="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Syncing">
                                    <Setter Property="Background" Value="{StaticResource SyncingRowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="RealTime">
                                    <Setter Property="Background" Value="{StaticResource RealTimeRowBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Begin Record" Binding="{Binding BaseIdBegin}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="End Record" Binding="{Binding BaseIdEnd}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Sync Starting Record" Binding="{Binding StartSyncPoint}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Messages" Padding="14,6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <Button Content="Clear Messages" Command="{Binding ClearMessagesCommand}" HorizontalAlignment="Left" />
                    </Border>
                    <ListBox ItemsSource="{Binding Messages}" BorderThickness="0" FontFamily="Consolas" Padding="4" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
