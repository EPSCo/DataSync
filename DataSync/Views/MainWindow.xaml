<Window x:Class="DataSync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="768" Height="576" MinWidth="768" MinHeight="576"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeBody}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource HeaderBrush}" Padding="14,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Current time" Foreground="{StaticResource HeaderMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CurrentTime}" Foreground="White" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" />
                    <Button Content="Settings" Command="{Binding SettingsCommand}" Style="{StaticResource HeaderButton}" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rig name" Foreground="{StaticResource HeaderMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding RigName}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Task status and actions -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.3*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Real time data" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding RealTimeState}" Style="{StaticResource StateValue}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RealTimeBatch}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="1" Text="Current record" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastBaseId}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="Record time" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastRecordTime}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Historical data" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding SyncState}" Style="{StaticResource StateValue}" />
                            <TextBlock Grid.Row="1" Text="Current record" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SyncNextBaseId}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SyncBatch}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                    <Button Content="{Binding SyncButtonText}" Command="{Binding ToggleSyncCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5" />
                    <Button Content="Test remote connection" Command="{Binding TestRemoteConnectionCommand}" Margin="0,0,0,5" />
                    <Button Content="Test local connection" Command="{Binding TestLocalConnectionCommand}" Margin="0,0,0,5" />
                    <Button Content="Clear local data" Command="{Binding ClearLocalDataCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
                    <UniformGrid Columns="2">
                        <Button Content="Restart" Command="{Binding RestartCommand}" Margin="0,0,3,0" />
                        <Button Content="Close" Click="CloseButton_Click" Margin="3,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ranges and messages -->
        <TabControl Grid.Row="2" Margin="10" Padding="1,0,1,6">
            <TabItem Header="Sync table">
                <DataGrid x:Name="SyncGrid" ItemsSource="{Binding Ranges}" BorderThickness="0">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Columns" IsEnabled="False" FontWeight="SemiBold" />
                            <Separator />
                            <MenuItem x:Name="BeginColumnMenuItem" Header="Begin" IsCheckable="True" IsChecked="True" Tag="BeginColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="EndColumnMenuItem" Header="End" IsCheckable="True" IsChecked="True" Tag="EndColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="CurrentColumnMenuItem" Header="Current" IsCheckable="True" IsChecked="True" Tag="CurrentColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="CountColumnMenuItem" Header="Count" IsCheckable="True" IsChecked="True" Tag="CountColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="TotalColumnMenuItem" Header="Total" IsCheckable="True" IsChecked="True" Tag="TotalColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="ProgressColumnMenuItem" Header="Progress" IsCheckable="True" IsChecked="True" Tag="ProgressColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="StatusColumnMenuItem" Header="Status" IsCheckable="True" IsChecked="True" Tag="StatusColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                            <MenuItem x:Name="SyncColumnMenuItem" Header="Sync" IsCheckable="True" IsChecked="True" Tag="SyncColumn" Checked="SyncColumnMenuItem_Toggled" Unchecked="SyncColumnMenuItem_Toggled" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Syncing">
                                    <Setter Property="Background" Value="{StaticResource SyncingRowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                </DataTrigger>
                                <!-- The values match the status text from MainViewModel.DescribeStatus. -->
                                <DataTrigger Binding="{Binding Status}" Value="Real-time">
                                    <Setter Property="Background" Value="{StaticResource RealTimeRowBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="BeginColumn" Binding="{Binding BaseIdBegin, StringFormat={}{0:N0}, ConverterCulture=en-US}" Width="*" ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Begin" ToolTip="First record" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="EndColumn" Binding="{Binding BaseIdEnd}" Width="*" ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="End" ToolTip="Last record" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="CurrentColumn" Binding="{Binding CurrentRecord}" Width="*" ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Current" ToolTip="Current record" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="CountColumn" Binding="{Binding Count}" Width="*" ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Count" ToolTip="Number of records" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="TotalColumn" Binding="{Binding Share}" Width="*" ElementStyle="{StaticResource CellTextRight}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Total" ToolTip="Total records" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ProgressColumn" Binding="{Binding Percent}" Width="*" ElementStyle="{StaticResource CellText}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Progress" ToolTip="Sync Progress" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource CellTextCenter}" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Status" ToolTip="Range state" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn x:Name="SyncColumn" Width="*" IsReadOnly="False" HeaderStyle="{StaticResource ColumnHeaderCenter}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Sync" ToolTip="Switch a range off to skip it, on to sync it" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SyncEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding SyncToggleEnabled}"
                                              Command="{Binding DataContext.ToggleRangeSyncCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="Switch this range off to skip it, on to sync it" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Messages">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Clear messages" Command="{Binding ClearMessagesCommand}" />
                            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="6,0,0,0"
                                    ToolTip="Opens the folder with the full log files, e.g. to send them for troubleshooting" />
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding Messages}" BorderThickness="0" FontFamily="Consolas" Padding="2" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
