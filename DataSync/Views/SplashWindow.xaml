<Window x:Class="DataSync.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataSync"
        Width="520" Height="300"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        FontFamily="Segoe UI"
        Background="{StaticResource HeaderBrush}">
    <Border BorderBrush="#334155" BorderThickness="1">
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/app.ico" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgramNameText" Foreground="White" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailsText" Foreground="{StaticResource HeaderMutedTextBrush}" FontSize="14" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource HeaderMutedTextBrush}" Margin="64,10,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="StatusText" Foreground="#CBD2D9" Margin="0,0,0,8" />
            <ProgressBar Grid.Row="2" x:Name="Progress" Height="6" Maximum="100"
                         Foreground="{StaticResource AccentBrush}" Background="#334155" BorderThickness="0" />
            <TextBlock Grid.Row="3" x:Name="CopyrightText" Foreground="#7B8794" FontSize="11" Margin="0,16,0,0" />
        </Grid>
    </Border>
</Window>
