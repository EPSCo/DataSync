<Window x:Class="DataSync.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:DataSync.Core.Configuration;assembly=DataSync.Core"
        Title="Settings"
        Width="660" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Based on the shared input styles, with equal heights for text boxes and the combo box. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="14,12">
        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" FontSize="16" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,10"
                   Text="Saved to the application configuration file. Changes take effect after the application restarts." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: general and replication -->
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rig name" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1"                                     Text="{Binding RigName, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Replication" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Real-time interval (s)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Seconds between real-time reads once caught up" />
                            <TextBox Grid.Row="0" Grid.Column="1"                                     Text="{Binding RealTimeUpdateInterval, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="Real-time row limit" Style="{StaticResource FieldLabel}"
                                       ToolTip="Maximum rows per real-time read" />
                            <TextBox Grid.Row="1" Grid.Column="1"                                     Text="{Binding RealTimeRowLimit, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Text="Sync pause (s)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Seconds to pause between sync (back-fill) batches; 0 = no pause" />
                            <TextBox Grid.Row="2" Grid.Column="1"                                     Text="{Binding SyncUpdateInterval, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Text="Sync row limit" Style="{StaticResource FieldLabel}"
                                       ToolTip="Maximum rows per sync batch" />
                            <TextBox Grid.Row="3" Grid.Column="1"                                     Text="{Binding SyncRowLimit, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Text="Gap check interval (min)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Minutes between checks for new gaps once nothing is left to sync" />
                            <TextBox Grid.Row="4" Grid.Column="1"                                     Text="{Binding GapCheckInterval, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5" Text="Max rows per second" Style="{StaticResource FieldLabel}"
                                       ToolTip="Upper limit on rows copied per second by each task; 0 = no limit" />
                            <TextBox Grid.Row="5" Grid.Column="1"                                     Text="{Binding MaxRowsPerSecond, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="6" Text="Failures before restart" Style="{StaticResource FieldLabel}"
                                       ToolTip="Consecutive failed reads/writes of one task before the application restarts" />
                            <TextBox Grid.Row="6" Grid.Column="1"                                     Text="{Binding TimeoutCounterLimit, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right: logging -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Logging" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Log directory" Style="{StaticResource FieldLabel}"
                                   ToolTip="Relative to the application folder unless a full path is given" />
                        <TextBox Grid.Row="0" Grid.Column="1"                                 Text="{Binding LogPathDir, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="New file every" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{x:Static config:EditableSettings.RollingIntervalNames}"
                                  SelectedItem="{Binding RollingInterval}" />

                        <TextBlock Grid.Row="2" Text="Roll on size limit" Style="{StaticResource FieldLabel}"
                                   ToolTip="Start a new file when the size limit is reached" />
                        <CheckBox Grid.Row="2" Grid.Column="1"                                  IsChecked="{Binding RollOnFileSizeLimit}" />

                        <TextBlock Grid.Row="3" Text="File size limit (bytes)" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1"                                 Text="{Binding FileSizeLimitBytes, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Text="Retained files" Style="{StaticResource FieldLabel}"
                                   ToolTip="Number of log files kept; older ones are deleted" />
                        <TextBox Grid.Row="4" Grid.Column="1"                                 Text="{Binding RetainedFileCountLimit, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
