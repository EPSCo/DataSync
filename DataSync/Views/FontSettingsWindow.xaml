<Window x:Class="DataSync.Views.FontSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font settings"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeBody}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="14,12">
        <TextBlock Text="Font settings" Style="{StaticResource DialogTitle}" />
        <TextBlock x:Name="HintText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />

        <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Padding="5,3" Margin="0,2" HorizontalContentAlignment="Right"
                                     Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,12,0,0">
            <Button Content="Defaults" MinWidth="90" Click="DefaultsButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button Content="Save" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
