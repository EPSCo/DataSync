<Window x:Class="DataSync.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="{DynamicResource FontSizeBody}"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="14,12">
        <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Border Style="{StaticResource Card}">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeFieldValue}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button x:Name="OkButton" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OkButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
