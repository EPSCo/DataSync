<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<!-- Connection strings are not here: they come only from local.eps / remote.eps next to the executable. -->
	<appSettings>
		<add key="ProgramName" value="DataSync" />
		<add key="ProgramDetails" value="Drilling Data Replication" />
		<add key="CompanyCopyright" value="©2026 EPSCo. All rights reserved (https://www.epsind.ir)" />
		<add key="RigName" value="MD-1" />

		<!-- ========== Logging ========== -->
		<!-- Log directory, relative to the executable unless rooted. Default: logs -->
		<add key="LogPathDir" value="logs" />

		<!-- New file every: Infinite, Year, Month, Day, Hour or Minute -->
		<add key="RollingInterval" value="Day" />

		<!-- Start a new file (_001, _002, ...) when the size limit is reached -->
		<add key="RollOnFileSizeLimit" value="true" />

		<!-- Max size (in bytes) of a log file before rolling -->
		<add key="FileSizeLimitBytes" value="1048576" />

		<!-- Number of log files kept; older ones are deleted -->
		<add key="RetainedFileCountLimit" value="10" />

		<!-- Least important messages written: Debug, Information, Warning or Error. Information logs startup details,
		     errors, outages and recoveries, and a one-minute summary per task. Debug also logs every remote read with its
		     timing, for troubleshooting a network; it writes much more, so raise FileSizeLimitBytes and
		     RetainedFileCountLimit to keep enough history. -->
		<add key="LogLevel" value="Information" />

		<!-- ========== Replication ========== -->
		<!-- Seconds between real-time reads once caught up (reads again immediately while full batches are returned) -->
		<add key="RealTimeUpdateInterval" value="1" />

		<!-- Maximum rows per real-time read -->
		<add key="RealTimeRowLimit" value="1000" />

		<!-- Seconds to pause between sync (back-fill) batches; 0 = no pause -->
		<add key="SyncUpdateInterval" value="0" />

		<!-- Maximum rows per sync batch -->
		<add key="SyncRowLimit" value="1000" />

		<!-- true: size each remote read from recent read times, between MinRowLimit and the row limits, aiming at
		     TargetBatchSeconds per read (for slow or high-latency links). false: always read the row limits. -->
		<add key="AdaptiveBatchSize" value="true" />

		<!-- Smallest adaptive read size; also the size of the first read -->
		<add key="MinRowLimit" value="20" />

		<!-- Seconds one remote read should take when adaptive; must be less than CommandTimeout -->
		<add key="TargetBatchSeconds" value="3" />

		<!-- Seconds before a database command (read or save) is abandoned as timed out. Minimum 5 -->
		<add key="CommandTimeout" value="60" />

		<!-- Upper limit on rows copied per second by each task, to protect the remote server; 0 = no limit -->
		<add key="MaxRowsPerSecond" value="5000" />

		<!-- Minutes between checks for new gaps after the sync task has nothing left to copy -->
		<add key="GapCheckInterval" value="10" />

		<!-- Consecutive failed reads/writes of one task (retried with 1s..60s back-off, real-time 1s..10s when
		     PrioritizeLatestData is true) before the app restarts. No restart while a database is unreachable: the tasks
		     keep retrying and resume when the network returns. -->

		<add key="TimeoutCounterLimit" value="10" />

		<!-- true: latest data first. When more real-time rows are waiting than one read carries (after an outage or on a
		     slow link), copy the newest rows first and back-fill the skipped ones at once, newest first; the sync task
		     pauses while real-time is behind or failing. false: catch up oldest-first, as DDRREP did. -->
		<add key="PrioritizeLatestData" value="true" />
	</appSettings>
</configuration>
