<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF on .NET Framework 4.8. No NuGet packages and no third-party controls. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>DataSync</RootNamespace>
    <AssemblyName>DataSync</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataSync.Core\DataSync.Core.csproj" />
  </ItemGroup>

</Project>
