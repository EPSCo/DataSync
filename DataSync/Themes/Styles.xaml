<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========== Palette ========== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F9FB" />
    <SolidColorBrush x:Key="LineBrush" Color="#D9DEE5" />
    <SolidColorBrush x:Key="LineLightBrush" Color="#EDF0F3" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2933" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#616E7C" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#1F2A37" />
    <SolidColorBrush x:Key="HeaderMutedTextBrush" Color="#9AA5B1" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1D6FB8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#175C99" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2F6" />
    <SolidColorBrush x:Key="PressedBrush" Color="#E1E7EE" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E3E" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C53030" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="SyncingRowBrush" Color="#FFF3C4" />
    <SolidColorBrush x:Key="RealTimeRowBrush" Color="#D3F2DC" />
    <SolidColorBrush x:Key="ColumnHeaderTextBrush" Color="#736D7A" />

    <!-- ========== Font sizes ========== -->
    <!-- Defaults; App replaces them with the saved Font settings (FontSettings). Use them with DynamicResource. -->
    <sys:Double x:Key="FontSizeBody">12</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">13</sys:Double>
    <sys:Double x:Key="FontSizeFieldLabel">13</sys:Double>
    <sys:Double x:Key="FontSizeFieldValue">13</sys:Double>
    <sys:Double x:Key="FontSizeTabHeader">14</sys:Double>
    <sys:Double x:Key="FontSizeButton">12</sys:Double>

    <!-- ========== Text ========== -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeFieldLabel}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,10,2" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeFieldValue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- A TaskState value, coloured by state. -->
    <Style x:Key="StateValue" TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
        <Style.Triggers>
            <Trigger Property="Text" Value="Downloading">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            </Trigger>
            <Trigger Property="Text" Value="NoOldData">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="Text" Value="Catching up">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Trigger>
            <Trigger Property="Text" Value="Waiting for real-time">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Trigger>
            <Trigger Property="Text" Value="Stop">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The title at the top of a dialog. -->
    <Style x:Key="DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!--
        Tabular figures: Segoe UI's digits are proportional by default, so record numbers of the same length come out
        different widths and the columns look ragged. This asks the font for fixed-width digits (the OpenType tnum
        feature) instead of a monospaced font, so the text stays Segoe UI. Fonts without the feature are unaffected.
    -->
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeFieldValue}" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!--
        Right-aligned numbers (Begin, End, Current, Count, Total). Cells without a value show an
        em dash ("—", see MainViewModel) which is centered instead via the trigger below.
    -->
    <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Right" />
        <Style.Triggers>
            <Trigger Property="Text" Value="—">
                <Setter Property="TextAlignment" Value="Center" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ColumnHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Text inside a column header. Set explicitly because the header content is a TextBlock. -->
    <Style x:Key="ColumnHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ========== Tabs ========== -->
    <!-- A rounded card with text tabs; the selected tab is accent coloured and underlined. -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource LineLightBrush}" BorderThickness="0,0,0,1" Padding="10,4,10,0">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <!-- Bottom padding keeps square content inside the rounded corners. -->
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"
                                              KeyboardNavigation.TabIndex="2" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTabHeader}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent" Margin="0,0,2,0">
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        <Border x:Name="Underline" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="6,0"
                                Background="{StaticResource AccentBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Buttons ========== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerLightBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button on the dark header bar. -->
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#52606D" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="10,2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#334155" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#3E4C59" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Inputs ========== -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========== Data grid ========== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineLightBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColumnHeaderTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!-- The grid is display-only: no selection highlight. -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
